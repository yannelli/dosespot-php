{
    "name": "yannelli/dosespot-php",
    "description": "A modern PHP client for the DoseSpot e-prescribing Web API.",
    "keywords": [
        "yannelli",
        "dosespot",
        "dosespot-php",
        "e-prescribing",
        "eprescribing",
        "epcs",
        "rx",
        "api-client",
        "healthcare"
    ],
    "homepage": "https://github.com/yannelli/dosespot-php",
    "license": "MIT",
    "authors": [
        {
            "name": "Yannelli",
            "email": "author@domain.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^8.1"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "pestphp/pest": "^3.0",
        "phpunit/phpunit": "^11.0",
        "spatie/ray": "^1.28"
    },
    "autoload": {
        "psr-4": {
            "Yannelli\\DoseSpot\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Yannelli\\DoseSpot\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/php-cs-fixer fix"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
